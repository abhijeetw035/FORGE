DATABASE_URL=postgresql://forge_user:forge_pass@postgres:5432/forge
REDIS_URL=redis://redis:6379
STORAGE_PATH=/storage

GITHUB_TOKEN=your_github_personal_access_token_here

# REQUIRED: random secret used to sign login tokens (the API refuses to start without it).
# Generate one with:  openssl rand -hex 32
SECRET_KEY=

# Browser origins allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000

# Git hosts users may add repositories from (comma-separated)
ALLOWED_GIT_HOSTS=github.com,gitlab.com
